# Axios Environment Configuration Template

# Application Settings
AXIOS_ENV=development
AXIOS_LOG_LEVEL=INFO

# AWS Credentials (Paste your IAM User keys here)
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# AWS IoT Core Settings
AWS_IOT_ENDPOINT=ak4ocz5tvo1yp-ats.iot.ap-south-1.amazonaws.com
AWS_IOT_TOPIC=freshtrace/device/FreshTrace-Node-01/telemetry
AWS_IOT_CLIENT_ID=FreshTrace-Node-01